# Copie este arquivo para .env (ou .env.local) e preencha com valores reais.
# NUNCA coloque os valores verdadeiros aqui neste arquivo de exemplo, e
# NUNCA faça commit do .env de verdade — ele já está no .gitignore.

# Projeto Supabase (Settings → API). Sem isso, o app roda normalmente com
# fallback local: autenticação e Reportar ficam indisponíveis, mas o mapa,
# a rota e os dados oficiais (EPTC/SMOI) continuam funcionando.
VITE_SUPABASE_URL=
# Chave PUBLISHABLE (sb_publishable_...) — a recomendada. Tudo que começa com
# VITE_ vai para o navegador: NUNCA use aqui a chave secret/service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Chave anon legada: só como fallback, enquanto você não migrar para a publishable.
VITE_SUPABASE_ANON_KEY=

# Chave da API do OpenRouteService (openrouteservice.org/dev). Sem isso, o
# cálculo de rota fica indisponível (mensagem explícita no app), o resto
# continua funcionando.
VITE_CHAVE_API_ORS=
